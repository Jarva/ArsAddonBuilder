{
  "multipart": [
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/empty",
        "uvlock": true,
        "y": 90,
        "x": 90
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/empty",
        "uvlock": true,
        "x": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/empty",
        "uvlock": true,
        "x": -90
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/empty",
        "uvlock": true,
        "y": -90,
        "x": 90
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/empty",
        "uvlock": true,
        "x": 180
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/empty",
        "uvlock": true
      }
    },

    {
      "when": {
        "facing": "east",
        "has_scroll": "true"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/scroll",
        "y": 90,
        "x": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "has_scroll": "true"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/scroll",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "has_scroll": "true"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/scroll",
        "x": -90
      }
    },
    {
      "when": {
        "facing": "west",
        "has_scroll": "true"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/scroll",
        "y": -90,
        "x": 90
      }
    },
    {
      "when": {
        "facing": "down",
        "has_scroll": "true"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/scroll",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "up",
        "has_scroll": "true"
      },
      "apply": {
        "model": "ars_controle:block/scroll_holder/scroll"
      }
    }
  ]
}